generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Hacker_Applications {
  id                        String                   @id @default(cuid())
  userId                    String                   @unique //foreign key to User
  // BASIC INFO
  first_name                String                   @db.VarChar(50)
  last_name                 String                   @db.VarChar(50)
  age                       Int
  school                    String                   @db.VarChar(250)
  major                     String                   @db.VarChar(250)
  grad_year                 Int
  level_of_study            String                   @db.VarChar(250)
  country                   String                   @db.VarChar(50)
  // SOCIALS
  email                     String                   @unique @db.VarChar(60)
  phone_number              String                   @db.VarChar(20)
  resume_path               String                   @db.VarChar(250)
  discord                   String?                  @db.VarChar(250)
  discord_id                String?                  @db.VarChar(50)
  discord_verification_code String?                  @db.VarChar(25)
  github                    String?                  @db.VarChar(250)
  linkedin                  String?                  @db.VarChar(250)
  // DEMOGRAPHIC INFO
  is_international          Boolean
  gender                    String                   @db.VarChar(50)
  pronouns                  String                   @db.VarChar(50)
  ethnicity                 String                   @db.VarChar(50)
  // STATUS
  dinosaur_avatar           Int                      @default(0)
  agreed_mlh_news           Boolean
  application_status        application_status_enums @default(waitlisted)
  check_in_status           Boolean                  @default(false)
  created_at                DateTime                 @default(now())
  user                      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hacker_applications")
}

enum application_status_enums {
  registered
  in_wave
  accepted
  confirmed
  withdrawn
  waitlisted
  checked_in
}

// Necessary for Next auth
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? // @db.Text
  access_token      String? // @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String?              @unique
  emailVerified      DateTime?
  image              String?
  discordId          String
  admin              Boolean?             @default(false)
  accounts           Account[]
  sessions           Session[]
  hacker_application Hacker_Applications?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
